<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="false"
        android:label="MedAtlas"
        android:icon="@drawable/ic_medatlas"
        android:supportsRtl="true"
        android:theme="@style/Theme.MedAtlas"
        android:usesCleartextTraffic="false">
        <activity android:name=".classroom.ClassroomActivity" android:exported="false" />
        <activity android:name=".books.MedicalBooksActivity" android:exported="false" />
        <activity android:name=".simulation.ClinicalSimulatorActivity" android:exported="false" />
        <activity android:name=".simulation.ExamSimulatorActivity" android:exported="false" />
        <activity android:name=".anatomy.Anatomy3DActivity" android:exported="false" />
        <activity android:name=".anatomy.OrganAtlasActivity" android:exported="false" />
        <activity android:name=".reference.MedicalReferenceActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
